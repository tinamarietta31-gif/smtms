{
  "name": "smtms-backend",
  "version": "1.0.0",
  "description": "Smart Mining Transport Monitoring System - Backend",
  "main": "app.js",
  "scripts": {
    "start": "node app.js",
    "dev": "nodemon app.js",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "seed": "node scripts/seedDatabase.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "build": "webpack build",
    "pm2:start": "pm2 start app.js --name smtms-backend",
    "pm2:stop": "pm2 stop smtms-backend",
    "pm2:restart": "pm2 restart smtms-backend",
    "pm2:logs": "pm2 logs smtms-backend",
    "docker:build": "docker build -t smtms-backend .",
    "docker:run": "docker run -p 5000:5000 smtms-backend",
    "health": "curl -f http://localhost:5000/api/auth/verify || echo 'Backend not responding'"
  },
  "keywords": [
    "mining",
    "transport",
    "tracking",
    "monitoring"
  ],
  "author": "Your Name",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.6.2",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.1.2",
    "mongoose": "^7.7.0",
    "nodemailer": "^6.9.7"
  },
  "devDependencies": {
    "eslint": "^8.50.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.1",
    "prettier": "^3.0.3",
    "supertest": "^6.3.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  }
}
