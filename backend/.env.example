# SMTMS Backend Environment Configuration

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/smtms
MONGODB_USER=admin
MONGODB_PASSWORD=

# JWT Configuration
JWT_SECRET=smtms_secret_key_change_in_production
JWT_EXPIRE=7d

# Server Configuration
PORT=5000
NODE_ENV=development

# CORS Configuration
CORS_ORIGIN=http://localhost:3000

# Email Configuration (for notifications)
EMAIL_SERVICE=gmail
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password

# ECM Integration (for remote vehicle control)
ECM_API_URL=http://ecm-provider-api.com
ECM_API_KEY=your_ecm_api_key

# ANPR Integration
ANPR_API_URL=http://anpr-provider-api.com
ANPR_API_KEY=your_anpr_api_key

# Toll Plaza Integration
TOLL_API_URL=http://toll-plaza-api.com
TOLL_API_KEY=your_toll_api_key

# ML Model Configuration
ML_MODEL_URL=http://localhost:5001
ML_API_KEY=your_ml_api_key

# Logging Configuration
LOG_LEVEL=debug
LOG_DIR=./logs

# Session Configuration
SESSION_SECRET=session_secret_key
SESSION_TIMEOUT=3600000

# Geographic Configuration
DEFAULT_LAT=28.6139
DEFAULT_LON=77.2090
MAP_PROVIDER=openstreetmap
